# ═══════════════════════════════════════════════════════════════════════════════
# DeepSeek V4 Pro — Opus 4.7-equivalent scaffold configuration
# ═══════════════════════════════════════════════════════════════════════════════

# API credentials
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model — single model, variable effort (like Opus 4.7's effort levels)
DEEPSEEK_MODEL=deepseek-v4-pro

# ── Effort mapping ──────────────────────────────────────────────────────────
# What reasoning_effort to use for STANDARD complexity queries.
# Options: low, medium, high, max
EFFORT_STANDARD=medium

# What reasoning_effort to use for COMPLEX queries.
# Options: low, medium, high, max
EFFORT_COMPLEX=high

# ── Pipeline switches ───────────────────────────────────────────────────────
ROUTER_ENABLED=true
VERIFIER_ENABLED=true
BEST_OF_N=3
MAX_REACT_ITERATIONS=8

# ── Task Budget (simulated Opus 4.7-style token countdown) ──────────────────
# Total token budget for a full agent loop (0 = unlimited)
TASK_BUDGET_TOKENS=128000
# At what % of budget we force the model to wrap up (0.0-1.0)
TASK_BUDGET_WRAPUP_PCT=0.80

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
