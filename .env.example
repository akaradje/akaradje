# DeepSeek API credentials
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Models — adjust if you have access to specific variants
# DeepSeek's official models: deepseek-chat (V3), deepseek-reasoner (R1)
# Set to whatever name your provider exposes (e.g. "deepseek-v4-pro")
MODEL_FAST=deepseek-chat
MODEL_STANDARD=deepseek-chat
MODEL_DEEP=deepseek-reasoner
MODEL_VERIFIER=deepseek-reasoner

# Pipeline tuning
ROUTER_ENABLED=true
VERIFIER_ENABLED=true
BEST_OF_N=3
MAX_REACT_ITERATIONS=8
TEMPERATURE_GENERATE=0.7
TEMPERATURE_VERIFIER=0.1

# Logging
LOG_LEVEL=INFO
